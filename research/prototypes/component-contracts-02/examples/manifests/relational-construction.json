{
  "contract": "ara.component-manifest",
  "version": "0.2.0",
  "componentId": "org.ara.prototype.relational-construction",
  "release": "0.2.0",
  "family": "relational-construction",
  "schemas": {
    "representation": "relational-construction.schema.json#/$defs/representation",
    "activity": "relational-construction.schema.json#/$defs/activity",
    "response": "relational-construction.schema.json#/$defs/response",
    "validator": "relational-construction.schema.json#/$defs/validator",
    "feedback": "common.schema.json#/$defs/feedbackContract"
  },
  "capabilities": {
    "responseModes": [
      "semantic-final-state",
      "operation-log"
    ],
    "validatorModes": [
      "deterministic"
    ],
    "determinism": "fully-deterministic",
    "rendererGeometryCanonical": false
