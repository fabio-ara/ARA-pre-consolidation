        "capabilityId": "relational-predicate-engine"
      }
    ],
    "isolationAssurance": "none",
    "productionEligibility": "conditionally-eligible",
    "runtimeVersion": "semantic-relational-adapter-0.2",
    "limits": {
      "timeMs": 1000,
      "memoryMiB": 64,
      "outputBytes": 65536,
      "outputMessages": 128,
      "cancellationRequired": false,
      "network": "none",
      "filesystem": "none"
    }
  },
  "securityBoundary": {
    "courseSuppliedCode": "forbidden",
    "learnerCode": "data-only",
    "trustedComponentCode": "installed-approved-adapter",
    "sensitiveData": "forbidden"
  },
  "accessibility": {
    "operations": [
      {
        "operation": "add-edge",
        "keyboard": "Select endpoints and activate add.",
        "nonvisual": "Linear node-edge editor.",
        "statusAnnouncement": "Announce added edge and current edge count.",
        "focusManagement": "Return focus to endpoint controls.",
        "reflow": "Visual board may use a bidimensional exception with an equivalent linear view.",
        "knownLimits": [
          "Dense graphs may overload both representations."
        ]
      },
      {
        "operation": "remove-edge",
        "keyboard": "Select endpoints and activate remove.",
        "nonvisual": "Linear edge list supports deletion.",
        "statusAnnouncement": "Announce removal or absence.",
        "focusManagement": "Restore focus after mutation.",
        "reflow": "Linear view reflows.",
        "knownLimits": []
      }
    ],
    "textAlternative": "A linear node-edge representation is mandatory.",
    "knownLimits": [
      "Domain-specific accessible interaction remains to be validated."
    ]
  },
  "offlineProfile": {
    "grade": "full",
    "networkDuringStudy": "forbidden",
    "packageRequirements": [
      "relational-model",
      "renderer-adapter"
    ],
    "limitations": []
