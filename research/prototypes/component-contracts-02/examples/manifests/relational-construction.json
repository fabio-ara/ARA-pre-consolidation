  },
  "validationEvidencePolicy": {
    "defaultVisibility": "learner",
    "retention": "attempt",
    "redactionRequired": true,
    "protectedKinds": [
      "protected-tests",
      "review-notes",
      "probabilistic-trace",
      "security-diagnostics"
