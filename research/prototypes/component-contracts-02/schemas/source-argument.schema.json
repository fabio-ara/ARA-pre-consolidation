{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ara.example/component-contracts/0.2/source-argument.schema.json",
  "title": "ARA source-argument component contract 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "componentRef",
    "family",
    "representation",
    "activity",
    "response",
    "validator",
    "feedback",
    "runtimeRequirements",
    "securityBoundary",
    "accessibility",
    "offlineProfile",
    "derivedStatePolicy",
    "validationEvidencePolicy"
  ],
  "properties": {
    "contract": {
      "const": "ara.component-prototype"
    },
    "version": {
      "const": "0.2.0"
    },
    "componentRef": {
      "$ref": "common.schema.json#/$defs/componentRef"
    },
    "family": {
      "const": "source-argument"
    },
    "representation": {
      "$ref": "#/$defs/representation"
    },
    "activity": {
      "$ref": "#/$defs/activity"
    },
    "response": {
      "$ref": "#/$defs/response"
    },
    "validator": {
      "$ref": "#/$defs/validator"
    },
    "feedback": {
      "$ref": "common.schema.json#/$defs/feedbackContract"
    },
    "runtimeRequirements": {
      "$ref": "common.schema.json#/$defs/runtimeRequirements"
    },
    "securityBoundary": {
      "$ref": "common.schema.json#/$defs/securityBoundary"
    },
    "accessibility": {
      "$ref": "common.schema.json#/$defs/accessibilityContract"
    },
    "offlineProfile": {
      "$ref": "common.schema.json#/$defs/offlineProfile"
    },
    "derivedStatePolicy": {
      "$ref": "common.schema.json#/$defs/derivedStatePolicy"
    },
    "validationEvidencePolicy": {
      "$ref": "common.schema.json#/$defs/validationEvidencePolicy"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "languageTag",
        "content",
        "digest",
        "citation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "languageTag": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "citation": {
          "type": "string"
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote",
        "prefix",
        "suffix",
        "start",
        "end",
        "sourceDigest"
      ],
      "properties": {
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceId",
        "selector",
        "purpose",
        "body",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sourceId": {
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "purpose": {
          "enum": [
            "evidence",
            "counterevidence",
            "context",
            "question",
            "classification"
          ]
        },
        "body": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "argumentNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "claim",
            "reason",
            "conclusion",
            "objection",
            "qualification"
          ]
        },
        "text": {
          "type": "string"
        }
      }
    },
    "argumentLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "relation"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "relation": {
          "enum": [
            "supports",
            "challenges",
            "qualifies",
            "uses-evidence",
            "concludes"
          ]
        }
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sources"
      ],
      "properties": {
        "kind": {
          "const": "source-set"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "objective",
        "phase",
        "operation",
        "prompt",
        "rubricId"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "theory",
            "guided-practice",
            "independent-practice",
            "reflection",
            "transfer"
          ]
        },
        "operation": {
          "enum": [
            "identify-evidence",
            "annotate",
            "compare",
            "construct-argument",
            "evaluate-argument",
            "explain"
          ]
        },
        "prompt": {
          "type": "string"
        },
        "rubricId": {
          "type": "string"
        },
        "scaffolds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "metadata",
        "annotations",
        "argumentNodes",
        "links"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "metadata": {
          "$ref": "common.schema.json#/$defs/responseMetadata"
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/annotation"
          }
        },
        "argumentNodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/argumentNode"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/argumentLink"
          }
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "deterministicChecks",
        "selectorResolutionPolicy",
        "rubricCriteria",
        "finalAuthority",
        "probabilisticAssistanceAllowed",
        "assistanceCannotFinalize",
        "validationLocations"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "deterministicChecks": {
          "type": "array",
          "items": {
            "enum": [
              "source-digest-matches",
              "selector-resolves",
              "quote-matches",
              "links-resolve",
              "evidence-linked"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "selectorResolutionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "order",
            "ambiguityOutcome",
            "sourceVersionPolicy"
          ],
          "properties": {
            "order": {
              "type": "array",
              "items": {
                "enum": [
                  "offset",
                  "quote-context",
                  "position-selector",
                  "manual-review"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "ambiguityOutcome": {
              "const": "ambiguous-non-silent"
            },
            "sourceVersionPolicy": {
              "enum": [
                "immutable-by-digest",
                "deployment-versioned"
              ]
            }
          }
        },
        "rubricCriteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterionId",
              "description",
              "authority",
              "weight"
            ],
            "properties": {
              "criterionId": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "authority": {
                "enum": [
                  "human-review",
                  "probabilistic-assistance"
                ]
              },
              "weight": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "finalAuthority": {
          "const": "human-review"
        },
        "probabilisticAssistanceAllowed": {
          "type": "boolean"
        },
        "assistanceCannotFinalize": {
          "const": true
        },
        "validationLocations": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/validationLocation"
          },
          "minItems": 1
        }
      }
    }
  }
}
