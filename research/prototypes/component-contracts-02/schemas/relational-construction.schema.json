{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ara.example/component-contracts/0.2/relational-construction.schema.json",
  "title": "ARA relational-construction component contract 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "componentRef",
    "family",
    "representation",
    "activity",
    "response",
    "validator",
    "feedback",
    "runtimeRequirements",
    "securityBoundary",
    "accessibility",
    "offlineProfile",
    "derivedStatePolicy",
    "validationEvidencePolicy"
  ],
  "properties": {
    "contract": {
      "const": "ara.component-prototype"
    },
    "version": {
      "const": "0.2.0"
    },
    "componentRef": {
      "$ref": "common.schema.json#/$defs/componentRef"
    },
    "family": {
      "const": "relational-construction"
    },
    "representation": {
      "$ref": "#/$defs/representation"
    },
    "activity": {
      "$ref": "#/$defs/activity"
    },
    "response": {
      "$ref": "#/$defs/response"
    },
    "validator": {
      "$ref": "#/$defs/validator"
    },
    "feedback": {
      "$ref": "common.schema.json#/$defs/feedbackContract"
    },
    "runtimeRequirements": {
      "$ref": "common.schema.json#/$defs/runtimeRequirements"
    },
    "securityBoundary": {
      "$ref": "common.schema.json#/$defs/securityBoundary"
    },
    "accessibility": {
      "$ref": "common.schema.json#/$defs/accessibilityContract"
    },
    "offlineProfile": {
      "$ref": "common.schema.json#/$defs/offlineProfile"
    },
    "derivedStatePolicy": {
      "$ref": "common.schema.json#/$defs/derivedStatePolicy"
    },
    "validationEvidencePolicy": {
      "$ref": "common.schema.json#/$defs/validationEvidencePolicy"
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "domainData": {
          "type": "object"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "directed"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "directed": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "domainData": {
          "type": "object"
        }
      }
    },
    "semanticState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grammar",
        "nodes",
        "edges",
        "semanticConstraints"
      ],
      "properties": {
        "grammar": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "semanticConstraints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "initialState"
      ],
      "properties": {
        "kind": {
          "const": "relational-construction"
        },
        "initialState": {
          "$ref": "#/$defs/semanticState"
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "objective",
        "phase",
        "operation",
        "prompt",
        "allowedOperations"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "theory",
            "guided-practice",
            "independent-practice",
            "reflection",
            "transfer"
          ]
        },
        "operation": {
          "enum": [
            "select",
            "connect",
            "disconnect",
            "label",
            "construct-path",
            "construct-subgraph",
            "transform",
            "explain"
          ]
        },
        "prompt": {
          "type": "string"
        },
        "allowedOperations": {
          "type": "array",
          "items": {
            "enum": [
              "add-node",
              "remove-node",
              "add-edge",
              "remove-edge",
              "change-label",
              "select"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "scaffolds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "operationLogItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "operation",
        "targetIds"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "operation": {
          "enum": [
            "add-node",
            "remove-node",
            "add-edge",
            "remove-edge",
            "change-label",
            "select"
          ]
        },
        "targetIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "value": {
          "type": "object"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "metadata",
        "finalState",
        "operationLog"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "metadata": {
          "$ref": "common.schema.json#/$defs/responseMetadata"
        },
        "finalState": {
          "$ref": "#/$defs/semanticState"
        },
        "operationLog": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operationLogItem"
          }
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "structuralChecks",
        "predicates",
        "authority",
        "validateSemanticStateOnly",
        "validationLocations"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "structuralChecks": {
          "type": "array",
          "items": {
            "enum": [
              "unique-ids",
              "endpoints-exist",
              "grammar-conforms",
              "allowed-operations-only"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "predicates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterionId",
              "predicate",
              "weight"
            ],
            "properties": {
              "criterionId": {
                "type": "string"
              },
              "predicate": {
                "enum": [
                  "path-exists",
                  "edge-set-equals",
                  "node-set-equals",
                  "connected",
                  "acyclic",
                  "is-tree",
                  "degree-condition",
                  "accepted-by-automaton",
                  "domain-predicate"
                ]
              },
              "parameters": {
                "type": "object"
              },
              "weight": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "authority": {
          "const": "deterministic-validator"
        },
        "validateSemanticStateOnly": {
          "const": true
        },
        "validationLocations": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/validationLocation"
          },
          "minItems": 1
        }
      }
    }
  }
}
