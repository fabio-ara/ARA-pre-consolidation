{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ara.example/component-contracts/0.2/executable-programming.schema.json",
  "title": "ARA executable-programming component contract 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "componentRef",
    "family",
    "representation",
    "activity",
    "response",
    "validator",
    "feedback",
    "runtimeRequirements",
    "securityBoundary",
    "accessibility",
    "offlineProfile",
    "derivedStatePolicy",
    "validationEvidencePolicy"
  ],
  "properties": {
    "contract": {
      "const": "ara.component-prototype"
    },
    "version": {
      "const": "0.2.0"
    },
    "componentRef": {
      "$ref": "common.schema.json#/$defs/componentRef"
    },
    "family": {
      "const": "executable-programming"
    },
    "representation": {
      "$ref": "#/$defs/representation"
    },
    "activity": {
      "$ref": "#/$defs/activity"
    },
    "response": {
      "$ref": "#/$defs/response"
    },
    "validator": {
      "$ref": "#/$defs/validator"
    },
    "feedback": {
      "$ref": "common.schema.json#/$defs/feedbackContract"
    },
    "runtimeRequirements": {
      "$ref": "common.schema.json#/$defs/runtimeRequirements"
    },
    "securityBoundary": {
      "$ref": "common.schema.json#/$defs/securityBoundary"
    },
    "accessibility": {
      "$ref": "common.schema.json#/$defs/accessibilityContract"
    },
    "offlineProfile": {
      "$ref": "common.schema.json#/$defs/offlineProfile"
    },
    "derivedStatePolicy": {
      "$ref": "common.schema.json#/$defs/derivedStatePolicy"
    },
    "validationEvidencePolicy": {
      "$ref": "common.schema.json#/$defs/validationEvidencePolicy"
    }
  },
  "$defs": {
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content",
        "editable"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+$"
        },
        "content": {
          "type": "string"
        },
        "editable": {
          "type": "boolean"
        },
        "language": {
          "type": "string"
        }
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "language",
        "runtimeProfile",
        "files",
        "entryPoint",
        "problemStatement"
      ],
      "properties": {
        "kind": {
          "const": "code-workspace"
        },
        "language": {
          "enum": [
            "python",
            "javascript"
          ]
        },
        "runtimeProfile": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceFile"
          },
          "minItems": 1
        },
        "entryPoint": {
          "type": "string"
        },
        "publicTests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicTest"
          }
        },
        "problemStatement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "publicTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testId",
        "kind"
      ],
      "properties": {
        "testId": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "unit",
            "property",
            "output",
            "exception",
            "complexity-bound"
          ]
        },
        "description": {
          "type": "string"
        },
        "input": {},
        "expected": {}
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "objective",
        "phase",
        "operation",
        "prompt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "theory",
            "guided-practice",
            "independent-practice",
            "reflection",
            "transfer"
          ]
        },
        "operation": {
          "enum": [
            "predict-output",
            "complete",
            "repair",
            "implement",
            "debug",
            "trace",
            "explain"
          ]
        },
        "prompt": {
          "type": "string"
        },
        "scaffolds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "metadata",
        "files",
        "requestedRun"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "metadata": {
          "$ref": "common.schema.json#/$defs/responseMetadata"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceFile"
          },
          "minItems": 1
        },
        "requestedRun": {
          "type": "boolean"
        },
        "stdin": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "testSuite": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "suiteId",
            "visibility",
            "tests",
            "weight"
          ],
          "properties": {
            "suiteId": {
              "type": "string"
            },
            "visibility": {
              "const": "public"
            },
            "tests": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/publicTest"
              },
              "minItems": 1
            },
            "weight": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "suiteId",
            "visibility",
            "hostReference",
            "weight"
          ],
          "properties": {
            "suiteId": {
              "type": "string"
            },
            "visibility": {
              "const": "protected"
            },
            "hostReference": {
              "type": "string",
              "minLength": 1
            },
            "weight": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "validityPipeline",
        "testSuites",
        "authority",
        "protectedMaterialInCourse",
        "validationLocations"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "validityPipeline": {
          "type": "array",
          "items": {
            "enum": [
              "decode",
              "parse",
              "compile",
              "import-policy",
              "resource-policy"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "testSuites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/testSuite"
          },
          "minItems": 1
        },
        "authority": {
          "const": "deterministic-validator"
        },
        "protectedMaterialInCourse": {
          "const": false
        },
        "styleDiagnosticsAuthority": {
          "const": "non-final"
        },
        "validationLocations": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/validationLocation"
          },
          "minItems": 1
        }
      }
    }
  }
}
