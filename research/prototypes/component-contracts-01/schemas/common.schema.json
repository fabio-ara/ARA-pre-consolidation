{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ara:prototype:common:0.1",
  "title": "ARA component prototype common definitions",
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "componentRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "languageTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "createdAt", "license"],
      "properties": {
        "authority": {"enum": ["project-authored", "adapted-open-source", "external-reference", "learner-authored"]},
        "createdAt": {"type": "string", "format": "date-time"},
        "sourceIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "license": {"type": "string", "minLength": 1},
        "contentDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyboard", "screenReader", "reflow", "nonDragAlternative", "focusOrder", "textAlternative"],
      "properties": {
        "keyboard": {"enum": ["required", "not-applicable"]},
        "screenReader": {"enum": ["required", "not-applicable"]},
        "reflow": {"enum": ["required", "bidimensional-exception-with-alternative"]},
        "nonDragAlternative": {"enum": ["required", "not-applicable"]},
        "focusOrder": {"enum": ["required"]},
        "textAlternative": {"enum": ["required", "not-applicable"]},
        "knownLimits": {"type": "array", "items": {"type": "string"}}
      }
    },
    "offlineProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade", "networkDuringStudy", "packageRequirements"],
      "properties": {
        "grade": {"enum": ["full", "package-required", "network-required", "unavailable"]},
        "networkDuringStudy": {"enum": ["forbidden", "optional", "required"]},
        "packageRequirements": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "maximumSuggestedPackageMiB": {"type": "number", "minimum": 0}
      }
    },
    "runtimeRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "network", "filesystem", "execution"],
      "properties": {
        "kind": {"enum": ["none", "deterministic-local", "sandboxed-worker", "trusted-service", "human-review"]},
        "network": {"enum": ["none", "read-only-allowlist", "controlled", "required"]},
        "filesystem": {"enum": ["none", "ephemeral-readonly", "ephemeral-readwrite"]},
        "execution": {"enum": ["none", "declarative", "sandboxed-code", "trusted-validator"]},
        "timeLimitMs": {"type": "integer", "minimum": 1},
        "memoryLimitMiB": {"type": "integer", "minimum": 1},
        "runtimeVersion": {"type": "string"},
        "reproducibilityDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "securityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["courseSuppliedCode", "trustedComponentCode", "learnerCode", "networkPolicy", "dataRetention"],
      "properties": {
        "courseSuppliedCode": {"const": "forbidden"},
        "trustedComponentCode": {"enum": ["built-in-only", "installed-approved-adapter"]},
        "learnerCode": {"enum": ["forbidden", "sandboxed"]},
        "networkPolicy": {"enum": ["none", "allowlist", "runtime-specific"]},
        "dataRetention": {"enum": ["local-session", "local-persistent", "server-project-policy"]},
        "sensitiveData": {"enum": ["forbidden", "project-policy-required"]}
      }
    },
    "criterionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "status", "authority"],
      "properties": {
        "criterionId": {"type": "string", "minLength": 1},
        "status": {"enum": ["not-evaluated", "invalid", "unsupported", "not-satisfied", "partially-satisfied", "satisfied", "review-required", "runtime-error"]},
        "authority": {"enum": ["deterministic-validator", "human-review", "probabilistic-assistance"]},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "weight": {"type": "number", "minimum": 0},
        "score": {"type": "number"}
      }
    },
    "feedbackItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "target", "content", "authority"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["confirmation", "correction", "explanation", "next-step", "prompt", "warning", "interpretation-preview"]},
        "target": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1},
        "authority": {"enum": ["authored-rule", "deterministic-validator", "human-review", "probabilistic-assistance"]},
        "reveal": {"enum": ["immediate", "after-confirmation", "after-attempt", "on-request", "after-review"]}
      }
    },
    "validationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responseId", "status", "validity", "criteria", "feedback", "finalAuthority"],
      "properties": {
        "responseId": {"type": "string", "minLength": 1},
        "status": {"enum": ["empty", "invalid", "valid-unassessed", "unsupported", "incorrect", "partially-satisfied", "correct", "review-required", "runtime-error"]},
        "validity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "messages"],
          "properties": {
            "status": {"enum": ["empty", "invalid-syntax", "invalid-structure", "invalid-reference", "valid"]},
            "interpretedAs": {},
            "messages": {"type": "array", "items": {"type": "string"}}
          }
        },
        "criteria": {"type": "array", "items": {"$ref": "#/$defs/criterionOutcome"}},
        "feedback": {"type": "array", "items": {"$ref": "#/$defs/feedbackItem"}},
        "score": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "awarded", "maximum"],
          "properties": {
            "policy": {"enum": ["none", "binary", "weighted-criteria", "partial-credit", "human-rubric"]},
            "awarded": {"type": "number"},
            "maximum": {"type": "number", "minimum": 0}
          }
        },
        "finalAuthority": {"enum": ["deterministic-validator", "human-review", "not-final-probabilistic-assistance"]},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "feedbackContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timing", "items", "scoreIndependent"],
      "properties": {
        "timing": {"enum": ["immediate", "after-confirmation", "after-attempt", "on-request", "after-review"]},
        "items": {"type": "array", "items": {"$ref": "#/$defs/feedbackItem"}},
        "scoreIndependent": {"const": true},
        "retryPolicy": {"enum": ["unlimited-formative", "limited", "disabled", "author-configured"]}
      }
    }
  }
}
