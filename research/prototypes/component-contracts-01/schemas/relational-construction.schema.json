{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ara:prototype:relational-construction:0.1",
  "title": "Relational construction component prototype",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "componentRef", "family", "representation", "activity", "response", "validator", "feedback", "runtimeRequirements", "securityBoundary", "accessibility", "offlineProfile"],
  "properties": {
    "contract": {"const": "ara.component-prototype"},
    "version": {"const": "0.1.0"},
    "componentRef": {"$ref": "common.schema.json#/$defs/componentRef"},
    "family": {"const": "relational-construction"},
    "representation": {"$ref": "#/$defs/representation"},
    "activity": {"$ref": "#/$defs/activity"},
    "response": {"$ref": "#/$defs/response"},
    "validator": {"$ref": "#/$defs/validator"},
    "feedback": {"$ref": "common.schema.json#/$defs/feedbackContract"},
    "runtimeRequirements": {"$ref": "common.schema.json#/$defs/runtimeRequirements"},
    "securityBoundary": {"$ref": "common.schema.json#/$defs/securityBoundary"},
    "accessibility": {"$ref": "common.schema.json#/$defs/accessibility"},
    "offlineProfile": {"$ref": "common.schema.json#/$defs/offlineProfile"}
  },
  "$defs": {
    "graphNode": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "label"],
      "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "label": {"type": "string"}, "data": {"type": "object"}}
    },
    "graphEdge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "from", "to", "directed"],
      "properties": {"id": {"type": "string", "minLength": 1}, "from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}, "directed": {"type": "boolean"}, "label": {"type": "string"}, "weight": {"type": "number"}, "data": {"type": "object"}}
    },
    "graphState": {
      "type": "object", "additionalProperties": false,
      "required": ["grammar", "nodes", "edges"],
      "properties": {
        "grammar": {"enum": ["graph-theory", "causal-network", "finite-automaton", "argument-map"]},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/graphNode"}, "uniqueItems": true},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/graphEdge"}, "uniqueItems": true},
        "semanticConstraints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "representation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "initialState", "rendererPolicy"],
      "properties": {
        "kind": {"const": "relational-construction"},
        "initialState": {"$ref": "#/$defs/graphState"},
        "rendererPolicy": {"type": "object", "additionalProperties": false, "required": ["persistCoordinates", "layoutAuthority"], "properties": {"persistCoordinates": {"const": false}, "layoutAuthority": {"const": "renderer-derived"}}}
      }
    },
    "activity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "objective", "phase", "operation", "prompt", "allowedOperations"],
      "properties": {
        "id": {"type": "string"}, "objective": {"type": "string"},
        "phase": {"enum": ["theory", "guided-practice", "independent-practice", "reflection", "transfer"]},
        "operation": {"enum": ["select", "connect", "disconnect", "label", "construct-path", "construct-subgraph", "classify-structure"]},
        "prompt": {"type": "string"},
        "allowedOperations": {"type": "array", "items": {"enum": ["add-node", "remove-node", "add-edge", "remove-edge", "edit-label", "select-node", "select-edge"]}, "uniqueItems": true},
        "scaffolds": {"type": "array", "items": {"type": "string"}}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "finalState", "operationLog"],
      "properties": {
        "id": {"type": "string"}, "finalState": {"$ref": "#/$defs/graphState"},
        "operationLog": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["sequence", "operation", "targetIds"], "properties": {"sequence": {"type": "integer", "minimum": 1}, "operation": {"enum": ["add-node", "remove-node", "add-edge", "remove-edge", "edit-label", "select-node", "select-edge"]}, "targetIds": {"type": "array", "items": {"type": "string"}}, "value": {}}}},
        "submittedAt": {"type": "string", "format": "date-time"}
      }
    },
    "validator": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "structuralChecks", "predicates", "authority"],
      "properties": {
        "id": {"type": "string"},
        "structuralChecks": {"type": "array", "items": {"enum": ["unique-ids", "endpoints-exist", "grammar-conforms", "allowed-operations-only"]}, "minItems": 1, "uniqueItems": true},
        "predicates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["criterionId", "predicate"], "properties": {"criterionId": {"type": "string"}, "predicate": {"enum": ["path-exists", "edge-set-equals", "node-set-equals", "connected", "acyclic", "is-tree", "degree-condition", "accepted-by-automaton"]}, "parameters": {"type": "object"}, "weight": {"type": "number", "minimum": 0}}}},
        "authority": {"const": "deterministic-validator"},
        "validateSemanticStateOnly": {"const": true}
      }
    }
  }
}
