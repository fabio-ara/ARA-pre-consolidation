{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ara:prototype:source-argument:0.1",
  "title": "Source annotation and argument component prototype",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "componentRef", "family", "representation", "activity", "response", "validator", "feedback", "runtimeRequirements", "securityBoundary", "accessibility", "offlineProfile"],
  "properties": {
    "contract": {"const": "ara.component-prototype"},
    "version": {"const": "0.1.0"},
    "componentRef": {"$ref": "common.schema.json#/$defs/componentRef"},
    "family": {"const": "source-argument"},
    "representation": {"$ref": "#/$defs/representation"},
    "activity": {"$ref": "#/$defs/activity"},
    "response": {"$ref": "#/$defs/response"},
    "validator": {"$ref": "#/$defs/validator"},
    "feedback": {"$ref": "common.schema.json#/$defs/feedbackContract"},
    "runtimeRequirements": {"$ref": "common.schema.json#/$defs/runtimeRequirements"},
    "securityBoundary": {"$ref": "common.schema.json#/$defs/securityBoundary"},
    "accessibility": {"$ref": "common.schema.json#/$defs/accessibility"},
    "offlineProfile": {"$ref": "common.schema.json#/$defs/offlineProfile"}
  },
  "$defs": {
    "selector": {
      "type": "object", "additionalProperties": false,
      "required": ["quote", "start", "end", "sourceDigest"],
      "properties": {
        "quote": {"type": "string", "minLength": 1},
        "prefix": {"type": "string"},
        "suffix": {"type": "string"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "sourceDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "annotation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourceId", "selector", "purpose", "body"],
      "properties": {
        "id": {"type": "string"},
        "sourceId": {"type": "string"},
        "selector": {"$ref": "#/$defs/selector"},
        "purpose": {"enum": ["evidence", "counterevidence", "definition", "context", "claim-support"]},
        "body": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "argumentNode": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "text"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["claim", "reason", "qualification", "counterclaim", "conclusion"]},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "representation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "sources"],
      "properties": {
        "kind": {"const": "source-set"},
        "sources": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "title", "languageTag", "content", "digest"],
            "properties": {
              "id": {"type": "string"},
              "title": {"type": "string"},
              "languageTag": {"$ref": "common.schema.json#/$defs/languageTag"},
              "content": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "citation": {"type": "string"}
            }
          }
        }
      }
    },
    "activity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "objective", "phase", "operation", "prompt"],
      "properties": {
        "id": {"type": "string"},
        "objective": {"type": "string"},
        "phase": {"enum": ["theory", "guided-practice", "independent-practice", "reflection", "transfer"]},
        "operation": {"enum": ["identify-evidence", "annotate", "compare-sources", "construct-argument", "evaluate-claim"]},
        "prompt": {"type": "string"},
        "rubricId": {"type": "string"},
        "scaffolds": {"type": "array", "items": {"type": "string"}}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "annotations", "argumentNodes", "links"],
      "properties": {
        "id": {"type": "string"},
        "annotations": {"type": "array", "items": {"$ref": "#/$defs/annotation"}},
        "argumentNodes": {"type": "array", "items": {"$ref": "#/$defs/argumentNode"}},
        "links": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to", "relation"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "relation": {"enum": ["supports", "challenges", "qualifies", "uses-evidence", "concludes"]}}}},
        "submittedAt": {"type": "string", "format": "date-time"}
      }
    },
    "validator": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "deterministicChecks", "rubricCriteria", "finalAuthority", "probabilisticAssistanceAllowed"],
      "properties": {
        "id": {"type": "string"},
        "deterministicChecks": {"type": "array", "items": {"enum": ["source-digest-matches", "selector-resolves", "quote-matches", "links-resolve", "evidence-linked"]}, "minItems": 1, "uniqueItems": true},
        "rubricCriteria": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["criterionId", "description", "authority"], "properties": {"criterionId": {"type": "string"}, "description": {"type": "string"}, "authority": {"enum": ["human-review", "probabilistic-assistance"]}, "weight": {"type": "number", "minimum": 0}}}},
        "finalAuthority": {"const": "human-review"},
        "probabilisticAssistanceAllowed": {"const": true},
        "assistanceCannotFinalize": {"const": true}
      }
    }
  }
}
