{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ara:prototype:semantic-mathematics:0.1",
  "title": "Semantic mathematics component prototype",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "componentRef", "family", "representation", "activity", "response", "validator", "feedback", "runtimeRequirements", "securityBoundary", "accessibility", "offlineProfile"],
  "properties": {
    "contract": {"const": "ara.component-prototype"},
    "version": {"const": "0.1.0"},
    "componentRef": {"$ref": "common.schema.json#/$defs/componentRef"},
    "family": {"const": "semantic-mathematics"},
    "representation": {"$ref": "#/$defs/representation"},
    "activity": {"$ref": "#/$defs/activity"},
    "response": {"$ref": "#/$defs/response"},
    "validator": {"$ref": "#/$defs/validator"},
    "feedback": {"$ref": "common.schema.json#/$defs/feedbackContract"},
    "runtimeRequirements": {"$ref": "common.schema.json#/$defs/runtimeRequirements"},
    "securityBoundary": {"$ref": "common.schema.json#/$defs/securityBoundary"},
    "accessibility": {"$ref": "common.schema.json#/$defs/accessibility"},
    "offlineProfile": {"$ref": "common.schema.json#/$defs/offlineProfile"}
  },
  "$defs": {
    "mathNode": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "number"}, "value": {"type": "number"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": {"kind": {"const": "symbol"}, "name": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "args"], "properties": {"kind": {"enum": ["add", "multiply"]}, "args": {"type": "array", "items": {"$ref": "#/$defs/mathNode"}, "minItems": 2}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "base", "exponent"], "properties": {"kind": {"const": "power"}, "base": {"$ref": "#/$defs/mathNode"}, "exponent": {"$ref": "#/$defs/mathNode"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "left", "right"], "properties": {"kind": {"enum": ["equals", "less-than", "greater-than"]}, "left": {"$ref": "#/$defs/mathNode"}, "right": {"$ref": "#/$defs/mathNode"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "numerator", "denominator"], "properties": {"kind": {"const": "fraction"}, "numerator": {"$ref": "#/$defs/mathNode"}, "denominator": {"$ref": "#/$defs/mathNode"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "name", "args"], "properties": {"kind": {"const": "function"}, "name": {"type": "string", "minLength": 1}, "args": {"type": "array", "items": {"$ref": "#/$defs/mathNode"}, "minItems": 1}}}
      ]
    },
    "representation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "languageTag", "expression", "accessibleText"],
      "properties": {
        "kind": {"const": "semantic-expression"},
        "languageTag": {"$ref": "common.schema.json#/$defs/languageTag"},
        "expression": {"$ref": "#/$defs/mathNode"},
        "accessibleText": {"type": "string", "minLength": 1},
        "variables": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "activity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "objective", "phase", "operation", "prompt"],
      "properties": {
        "id": {"type": "string"},
        "objective": {"type": "string", "minLength": 1},
        "phase": {"enum": ["theory", "guided-practice", "independent-practice", "reflection", "transfer"]},
        "operation": {"enum": ["interpret", "construct-equivalent", "simplify", "factor", "solve", "differentiate", "compare-strategies"]},
        "prompt": {"type": "string", "minLength": 1},
        "scaffolds": {"type": "array", "items": {"type": "string"}}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "inputFormat", "originalInput", "submittedExpression"],
      "properties": {
        "id": {"type": "string"},
        "inputFormat": {"enum": ["math-json", "latex", "asciimath"]},
        "originalInput": {"type": "string"},
        "submittedExpression": {"$ref": "#/$defs/mathNode"},
        "units": {"type": "object", "additionalProperties": {"type": "integer"}},
        "submittedAt": {"type": "string", "format": "date-time"}
      }
    },
    "validator": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "validityChecks", "propertyTests", "authority"],
      "properties": {
        "id": {"type": "string"},
        "validityChecks": {"type": "array", "items": {"enum": ["parseable", "symbols-declared", "domain-defined", "units-parseable"]}, "minItems": 1, "uniqueItems": true},
        "propertyTests": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["criterionId", "test"],
            "properties": {
              "criterionId": {"type": "string"},
              "test": {"enum": ["equivalent-to-reference", "required-form", "numeric-tolerance", "units-equivalent", "domain-equivalent"]},
              "referenceExpression": {"$ref": "#/$defs/mathNode"},
              "requiredForm": {"enum": ["factorized", "expanded", "simplified", "equation-solved"]},
              "tolerance": {"type": "number", "minimum": 0},
              "weight": {"type": "number", "minimum": 0}
            }
          }
        },
        "authority": {"const": "deterministic-validator"},
        "interpretationPreviewRequired": {"const": true}
      }
    }
  }
}
