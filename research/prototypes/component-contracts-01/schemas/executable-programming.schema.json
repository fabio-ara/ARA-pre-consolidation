{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ara:prototype:executable-programming:0.1",
  "title": "Executable programming component prototype",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "componentRef", "family", "representation", "activity", "response", "validator", "feedback", "runtimeRequirements", "securityBoundary", "accessibility", "offlineProfile"],
  "properties": {
    "contract": {"const": "ara.component-prototype"},
    "version": {"const": "0.1.0"},
    "componentRef": {"$ref": "common.schema.json#/$defs/componentRef"},
    "family": {"const": "executable-programming"},
    "representation": {"$ref": "#/$defs/representation"},
    "activity": {"$ref": "#/$defs/activity"},
    "response": {"$ref": "#/$defs/response"},
    "validator": {"$ref": "#/$defs/validator"},
    "feedback": {"$ref": "common.schema.json#/$defs/feedbackContract"},
    "runtimeRequirements": {"$ref": "common.schema.json#/$defs/runtimeRequirements"},
    "securityBoundary": {"$ref": "common.schema.json#/$defs/securityBoundary"},
    "accessibility": {"$ref": "common.schema.json#/$defs/accessibility"},
    "offlineProfile": {"$ref": "common.schema.json#/$defs/offlineProfile"}
  },
  "$defs": {
    "sourceFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "content", "editable"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"},
        "content": {"type": "string"},
        "editable": {"type": "boolean"},
        "language": {"type": "string"}
      }
    },
    "representation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "language", "runtimeProfile", "files", "entryPoint"],
      "properties": {
        "kind": {"const": "code-workspace"},
        "language": {"enum": ["python", "javascript"]},
        "runtimeProfile": {"type": "string", "minLength": 1},
        "files": {"type": "array", "items": {"$ref": "#/$defs/sourceFile"}, "minItems": 1},
        "entryPoint": {"type": "string"},
        "publicTests": {"type": "array", "items": {"type": "string"}},
        "problemStatement": {"type": "string", "minLength": 1}
      }
    },
    "activity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "objective", "phase", "operation", "prompt"],
      "properties": {
        "id": {"type": "string"},
        "objective": {"type": "string"},
        "phase": {"enum": ["theory", "guided-practice", "independent-practice", "reflection", "transfer"]},
        "operation": {"enum": ["predict-output", "complete", "repair", "implement", "debug", "trace", "explain"]},
        "prompt": {"type": "string"},
        "scaffolds": {"type": "array", "items": {"type": "string"}}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "files", "requestedRun"],
      "properties": {
        "id": {"type": "string"},
        "files": {"type": "array", "items": {"$ref": "#/$defs/sourceFile"}, "minItems": 1},
        "requestedRun": {"type": "boolean"},
        "stdin": {"type": "array", "items": {"type": "string"}},
        "submittedAt": {"type": "string", "format": "date-time"}
      }
    },
    "validator": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "validityPipeline", "testSuites", "authority", "hiddenTestsProtected"],
      "properties": {
        "id": {"type": "string"},
        "validityPipeline": {"type": "array", "items": {"enum": ["decode", "parse", "compile", "import-policy", "resource-policy"]}, "minItems": 1, "uniqueItems": true},
        "testSuites": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["suiteId", "visibility", "tests", "weight"],
            "properties": {
              "suiteId": {"type": "string"},
              "visibility": {"enum": ["public", "protected"]},
              "tests": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["testId", "kind"], "properties": {"testId": {"type": "string"}, "kind": {"enum": ["unit", "property", "output", "exception", "complexity-bound"]}, "description": {"type": "string"}, "input": {}, "expected": {}}}},
              "weight": {"type": "number", "minimum": 0}
            }
          }
        },
        "authority": {"const": "deterministic-validator"},
        "hiddenTestsProtected": {"const": true},
        "styleDiagnosticsAuthority": {"const": "non-final"}
      }
    }
  }
}
